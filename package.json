  "scripts": {
    "build:dev": "cross-env NODE_ENV=development webpack --config webpack.config.ts --mode development",
    "build:prod": "cross-env NODE_ENV=production webpack --config webpack.config.ts --mode production",
    "dev": "cross-env NODE_ENV=development webpack serve --config webpack.config.ts --mode development",
    "clean": "rimraf ./public/main.bundle.js",
    "test": "jest",
    "lint": "eslint src/**/*.{ts,tsx,js,jsx}",
    "lint:fix": "eslint src/**/*.{ts,tsx,js,jsx} --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,css,scss,md}'",
    "deploy": "gh-pages -d public",
    "build:prod-analyze": "cross-env NODE_ENV=production webpack --config webpack.config.ts --mode production --env analyze=true",
    "dev-analyze": "cross-env NODE_ENV=development webpack serve --config webpack.config.ts --mode development --env analyze=true --env hot=false",
    "prepare": "husky",
    "codegen": "orval --config orval.config.ts",
    "openapi:pull": "node scripts/fetch-openapi.mjs",
    "openapi:sync": "node scripts/openapi-sync.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npx eslint --fix"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
