  "info": {
    "title": "Workforms API",
    "description": "REST API for Workforms.\nWebSocket events (chat) are not described here — use a Socket.IO client.\n\nAuth: session cookies (not Bearer header). After login/register, the browser stores cookies; use the same origin or forward cookies in tools like Postman.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "short_token",
        "description": "HttpOnly cookies from POST /api/user/login or /api/user/register. The API accepts short_token or long_token."
      }
    },
    "schemas": {
      "RegisterUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "john@example.com"
          },
          "password": {
            "type": "string",
            "example": "secret123"
          },
          "login": {
            "type": "string",
            "example": "john_doe"
          }
        },
        "required": [
          "email",
          "password",
          "login"
        ]
      },
      "UserPublicResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "clx123abc456"
          },
          "email": {
            "type": "string",
            "example": "john@example.com"
          },
          "login": {
            "type": "string",
            "example": "john_doe"
          }
        },
        "required": [
          "id",
          "email",
          "login"
        ]
      },
      "RegisterUserResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserPublicResponseDto"
          }
        },
        "required": [
          "user"
        ]
      },
      "LoginUserDto": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "example": "john@example.com"
          },
          "password": {
            "type": "string",
            "example": "secret123"
          }
        },
        "required": [
          "login",
          "password"
        ]
      },
      "ProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "jobTitle": {
            "type": "string",
            "example": "Frontend Developer"
          },
          "experience": {
            "type": "string",
            "example": "3 years"
          },
          "location": {
            "type": "string",
            "example": "Warsaw, Poland"
          },
          "skills": {
            "example": [
              "React",
              "TypeScript",
              "CSS"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bio": {
            "type": "string",
            "example": "Building user interfaces and design systems."
          },
          "photo": {
            "type": "string",
            "example": "https://example.com/uploads/profile-photo.jpg"
          }
        },
        "required": [
          "name",
          "jobTitle",
          "experience",
          "location",
          "skills",
          "bio",
          "photo"
        ]
      },
      "JobPreferencesDto": {
        "type": "object",
        "properties": {
          "jobType": {
            "example": [
              "full-time",
              "contract"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "workLocation": {
            "type": "string",
            "example": "remote"
          },
          "salaryMin": {
            "type": "string",
            "example": "2000"
          },
          "salaryMax": {
            "type": "string",
            "example": "4000"
          },
          "industries": {
            "example": [
              "ecommerce",
              "fintech"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "willingToRelocate": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "jobType",
          "workLocation",
          "salaryMin",
          "salaryMax",
          "industries",
          "willingToRelocate"
        ]
      },
      "NotificationAlertsDto": {
        "type": "object",
        "properties": {
          "jobMatches": {
            "type": "boolean",
            "example": true
          },
          "applicationUpdates": {
            "type": "boolean",
            "example": true
          },
          "interviewReminders": {
            "type": "boolean",
            "example": false
          },
          "formsInsights": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "jobMatches",
          "applicationUpdates",
          "interviewReminders",
          "formsInsights"
        ]
      },
      "NotificationsDto": {
        "type": "object",
        "properties": {
          "alerts": {
            "$ref": "#/components/schemas/NotificationAlertsDto"
          },
          "notificationStyle": {
            "type": "string",
            "enum": [
              "email",
              "push",
              "both"
            ],
            "example": "both"
          }
        },
        "required": [
          "alerts",
          "notificationStyle"
        ]
      },
      "PrivacyDto": {
        "type": "object",
        "properties": {
          "showSalaryExpectations": {
            "type": "boolean",
            "example": false
          },
          "showContactInfo": {
            "type": "boolean",
            "example": true
          },
          "allowRecruiterMessages": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "showSalaryExpectations",
          "showContactInfo",
          "allowRecruiterMessages"
        ]
      },
      "AccountDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "john@example.com"
          },
          "language": {
            "type": "string",
            "example": "en"
          }
        },
        "required": [
          "email",
          "language"
        ]
      },
      "SaveSettingsDto": {
        "type": "object",
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/ProfileDto"
          },
          "jobPreferences": {
            "$ref": "#/components/schemas/JobPreferencesDto"
          },
          "notifications": {
            "$ref": "#/components/schemas/NotificationsDto"
          },
          "privacy": {
            "$ref": "#/components/schemas/PrivacyDto"
          },
          "account": {
            "$ref": "#/components/schemas/AccountDto"
          }
        },
        "required": [
          "profile",
          "jobPreferences",
          "notifications",
          "privacy",
          "account"
        ]
      },
      "UserProfileResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserPublicResponseDto"
          },
          "settings": {
            "$ref": "#/components/schemas/SaveSettingsDto"
          }
        },
        "required": [
          "user",
          "settings"
        ]
      },
      "FormTemplateListItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "schemaKey": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "object",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED"
            ]
          },
          "lifecycle": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "ARCHIVED",
              "DELETED"
            ]
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "schemaKey",
          "title",
          "status",
          "lifecycle",
          "updatedAt"
        ]
      },
      "FormTemplateListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FormTemplateListItemDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "FormTemplateDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "schemaKey": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED"
            ]
          },
          "lifecycle": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "ARCHIVED",
              "DELETED"
            ]
          },
          "authorId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "schema": {
            "type": "object",
            "additionalProperties": true,
            "description": "FormSchema JSON"
          }
        },
        "required": [
          "id",
          "schemaKey",
          "status",
          "lifecycle",
          "authorId",
          "createdAt",
          "updatedAt",
          "schema"
        ]
      },
      "CreateFormTemplateDto": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "object",
            "description": "Full FormSchema JSON (constructor-form)",
            "additionalProperties": true
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED"
            ],
            "default": "DRAFT"
          }
        },
        "required": [
          "schema"
        ]
      },
      "UpdateFormTemplateDto": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "object",
            "description": "Full FormSchema JSON",
            "additionalProperties": true
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED"
            ]
          }
        },
        "required": [
          "schema"
        ]
      },
      "UpdateFormTemplateLifecycleDto": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "archive",
              "softDelete",
              "restore"
            ]
          }
        },
        "required": [
          "action"
        ]
      }
    }
  }
}